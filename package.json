{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Aggregate overlapping hotel offers from two mock suppliers using Temporal.io, Redis, and Express",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev:api": "cross-env ROLE=api ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:worker": "cross-env ROLE=worker ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "start:worker": "cross-env ROLE=worker node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "temporal",
    "redis",
    "express",
    "typescript",
    "hotel"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "axios": "^1.20.0",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2"
  }
}
